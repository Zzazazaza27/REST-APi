# Application Configuration
PROJECT_NAME="Deribit Price Tracker API"
DEBUG=false
ENVIRONMENT=production

# PostgreSQL Database
POSTGRES_USER=deribit_user
POSTGRES_PASSWORD=deribit_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=deribit_db
# Optional full URI override:
# DATABASE_URL=postgresql+asyncpg://deribit_user:deribit_password@localhost:5432/deribit_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Deribit Exchange Integration
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
DERIBIT_TIMEOUT_SECONDS=10.0
TRACKED_TICKERS=["btc_usd", "eth_usd"]
FETCH_INTERVAL_SECONDS=60.0
